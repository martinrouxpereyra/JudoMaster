@*@page
@model JudoMaster.Pages.Institutions.Create
@{
    ViewData["Title"] = "Nueva Institución";
}

<h2>Crear Nueva Institución</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Institution.Name">Nombre</label>
        <input asp-for="Institution.Name" class="form-control" />
        <span asp-validation-for="Institution.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Institution.Country">Ubicación</label>
        <input asp-for="Institution.Country" class="form-control" />
        <span asp-validation-for="Institution.Country" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Institution.City">Ubicación</label>
        <input asp-for="Institution.City" class="form-control" />
        <span asp-validation-for="Institution.City" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}*@